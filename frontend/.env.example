# El frontend llama a "/api" (ruta relativa) y el servidor de desarrollo de
# Vite reenvia esa ruta al backend. Por eso NO hay que fijar el puerto aqui:
# Vite busca solo el backend en los puertos habituales (8000-8003) al arrancar.
#
# Por eso el puerto del backend deja de importar: "php artisan serve" toma el
# primer puerto libre desde el 8000, y ese cambia segun lo que este corriendo
# en la maquina.
#
# Para apuntar a un puerto fijo:
#   VITE_API_TARGET=http://127.0.0.1:8000
#
# Para un despliegue estatico (sin proxy inverso), la URL completa de la API:
#   VITE_API_URL=https://api.eltrebol.com/api
#
# Si se deja vacio, se detecta el backend automaticamente.
VITE_API_TARGET=
